# Copy this file to .env and fill in at least one LLM provider.

# LLM providers
# Configure at least one. When several are configured they are tried in this fixed
# order, each falling back to the next: Gemini -> Groq -> OpenAI -> local Ollama.
# A provider is skipped unless BOTH its API key and its model are set.
#
# Agent loops are call-hungry -- one run can be 5-15 LLM calls -- so free-tier
# rate limits bite much harder here than in the RAG lab. Configuring two cloud
# providers is worth it.

GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-flash-latest
GEMINI_LLM_FAST_MODEL=gemini-flash-lite-latest

GROQ_API_KEY=
# gpt-oss-120b $0.15/$0.60 per 1M in/out, gpt-oss-20b $0.075/$0.30.
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_LLM_FAST_MODEL=openai/gpt-oss-20b

OPENAI_API_KEY=
# gpt-5-mini $0.25/$2.00 per 1M in/out, gpt-5-nano $0.05/$0.40.
OPENAI_LLM_MODEL=gpt-5-mini
OPENAI_LLM_FAST_MODEL=gpt-5-nano

# Local Ollama -- runs on the host, not in Docker. One model, no fast variant:
#   ollama pull qwen2.5:7b-instruct   # this default tag is already the Q4_K_M quant
# The model value must match a name in `ollama list` exactly, or every call fails
# with "model not found". Docker Desktop reaches an Ollama bound to 127.0.0.1; on
# Linux Docker Engine, start it with OLLAMA_HOST=0.0.0.0 instead.
# ~4.7 GB resident: on an 8 GB box it competes with the app and the embedding model.
# Small local models are weak at multi-step tool calling -- expect the agentic demos
# to be noticeably worse on this fallback than on a cloud provider.
LOCAL_OLLAMA_BASE_URL=http://host.docker.internal:11434
LOCAL_OLLAMA_LLM_MODEL=qwen2.5:7b-instruct

# Local models
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# MongoDB Atlas Local (docker service "mongodb")
MONGODB_USERNAME=admin
MONGODB_PASSWORD=change-me
MONGODB_URI=mongodb://admin:change-me@mongodb:27017/?directConnection=true
MONGODB_DB=genai_agentic_lab

# Langfuse (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------------------------------------------------------------------------
# Budgets. Every run is bounded by all three; the page shows them being spent
# and a run that hits one stops and says which. Per-demo overrides live in
# config.py, in the same style as the RAG lab's per-demo caps.
# ---------------------------------------------------------------------------
AGENT_MAX_STEPS=12
AGENT_MAX_TOKENS=60000
AGENT_DEADLINE_S=180

# Tools
TOOL_TIMEOUT_S=30
WEB_SEARCH_RESULTS=4
SQL_ROW_LIMIT=50
CORPUS_TOP_K=5
CORPUS_CHUNK_SIZE=800
CORPUS_CHUNK_OVERLAP=100
# The virtual file system the deep-agent and autonomous demos write into.
VFS_ROOT=data/vfs
VFS_MAX_FILE_KB=256
VFS_MAX_FILES=50

# Demo-specific caps (add one per demo as it lands)
REFLEXION_MAX_ATTEMPTS=3
PLAN_EXECUTE_MAX_PLAN_STEPS=6
# Plan-and-Execute's own step budget default: a replan costs one model call per
# executed step, so the shared AGENT_MAX_STEPS is too tight for this demo's sidebar.
PLAN_EXECUTE_MAX_STEPS=20
SUPERVISOR_MAX_HOPS=8
SWARM_MAX_HANDOFFS=6
SUBAGENT_MAX_STEPS=6
MEMORY_RECALL_K=5
# HITL gates: comma-separated tool names paused for approval by default.
HITL_GATED_TOOLS=write_file
# Escalation: judge confidence below this triggers a handoff.
ESCALATION_CONFIDENCE_THRESHOLD=0.7
# Escalation: this many failed tool calls without recovery also triggers a handoff.
ESCALATION_MAX_TOOL_ERRORS=2
AUTONOMOUS_MAX_OBJECTIVES=8
RESEARCH_MAX_SUBQUESTIONS=4
EVAL_TASK_SET_SIZE=8
# A2A: the remote "Corpus researcher" agent's own step cap -- never the client's.
A2A_REMOTE_MAX_STEPS=6
# Deep agents: sub-agent launches per run, and this page's own step-cap default
# (sub-agents reuse SUBAGENT_MAX_STEPS above as their own per-launch cap).
DEEP_AGENT_MAX_SUBAGENTS=4
DEEP_AGENT_MAX_STEPS=30
# Deep agents' own token-budget default: the harness's system prompt and tool schemas
# cost ~5k tokens per call before any work, so the shared AGENT_MAX_TOKENS runs out early.
DEEP_AGENT_MAX_TOKENS=150000
# Autonomous loop: the demo's own step-budget default -- three model calls per
# objective (propose, act, critique), so AUTONOMOUS_MAX_OBJECTIVES x 3 needs headroom.
AUTONOMOUS_MAX_STEPS=30
# Cosine-similarity floor (core.embeddings, bge-small) above which two objectives
# are flagged as near-duplicates in the spin tally.
AUTONOMOUS_DUP_THRESHOLD=0.9
# Deep research's own step-budget default: decompose + each sub-question's
# researcher turns + synthesise runs past the shared AGENT_MAX_STEPS default.
RESEARCH_MAX_STEPS=30
# Per-sub-question researcher step cap -- spending it moves on to the next
# sub-question rather than stopping the run; the shared budget still can.
RESEARCH_MAX_STEPS_PER_QUESTION=6
# Deep research's own token-budget default -- each sub-question re-sends its own
# growing history, so the shared AGENT_MAX_TOKENS runs out before the brief.
RESEARCH_MAX_TOKENS=60000
# Text-to-SQL analyst: consecutive run_sql failures allowed before the next call
# is refused outright rather than sent to SQLite.
SQL_ANALYST_MAX_SQL_RETRIES=1
